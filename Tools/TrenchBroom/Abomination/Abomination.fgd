// Entity definitions of Abomination for TrenchBroom: the entities that can be placed on a map, their size and color
// in the editor, and their properties. Sizes are in Quake units (32 units are about 1 meter in the game).

// The world: all static brushes of the level (walls, floors, ceilings) belong to it. Every map has exactly one.
@SolidClass = worldspawn : "World entity" []

// Where the player appears when the map starts. The box has the size of the Quake player: 32 x 32 units wide,
// 56 units tall, with the origin 24 units above its bottom.
@PointClass size(-16 -16 -24, 16 16 32) color(0 255 0) = info_player_start : "Player start"
[
    angle(integer) : "Direction the player looks, in degrees around the vertical axis" : 0
]

// A model standing in the level, drawn as it is (it does not move and cannot be picked up). The model is a glTF file
// in Assets (.glb). TrenchBroom shows it too; models are made in meters, so the editor scales them by 32 to map units.
@PointClass size(-8 -8 -8, 8 8 8) color(255 128 0) model({ "path": model, "scale": 32 }) = misc_model : "Model"
[
    model(string) : "Model file, relative to the Assets folder" : "Models/Weapons/Shotgun.glb"
    angle(integer) : "Direction the model faces, in degrees around the vertical axis" : 0
]

// The dog, a melee monster: it wanders, sniffs, notices the player by sight or by the sound of shots, runs at them and
// bites. Its box is 34 units across (as long as the dog, so its muzzle and tail stay inside) and 24 tall, its origin at
// the bottom, between the paws, like the origin of its model: placed on the floor, the dog stands on it.
@PointClass size(-20 -20 0, 20 20 29) color(200 40 40) model({ "path": "Models/Enemies/Dog.glb", "scale": 38.4 }) = monster_dog : "Dog"
[
    angle(integer) : "Direction the dog faces, in degrees around the vertical axis" : 0
]

// A light shining into every direction: a torch, a candle, a brazier (named like the lights of Unity). The editor shows
// it as a small crystal; the game shows it as a star with circles of its range when Lights is checked in the Renderer
// window (see World/MapLights.h).
@PointClass size(-8 -8 -8, 8 8 8) color(255 220 120) model({ "path": "Models/Editor/PointLight.glb", "scale": 32 }) = point_light : "Point light"
[
    intensity(float) : "The light at 1 m: 3 lights a white surface fully" : "5"
    range(float) : "Where the light is faded out, in units (32 units are 1 m)" : "320"
    _color(color255) : "Color" : "255 255 255"
]

// A light shining in a cone: a lantern with a shutter, a light through a window. The editor shows the cone opening
// the way it shines; the rotate tool turns it and writes its angles.
@PointClass size(-8 -8 -8, 8 8 8) color(255 180 80) model({ "path": "Models/Editor/SpotLight.glb", "scale": 32 }) = spot_light : "Spot light"
[
    intensity(float) : "The light at 1 m: 3 lights a white surface fully" : "30"
    range(float) : "Where the light is faded out, in units (32 units are 1 m)" : "320"
    _color(color255) : "Color" : "255 255 255"
    angles(string) : "Where it shines: pitch yaw roll, in degrees (pitch 90 straight down, -90 straight up)" : "0 0 0"
    cone(float) : "Angle from the axis to the edge of the light, in degrees" : "30"
    inner_cone(float) : "Angle up to which the light is full, in degrees; it fades out from there to the edge" : "20"
]
