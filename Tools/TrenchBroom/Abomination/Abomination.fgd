// Entity definitions of Abomination for TrenchBroom: the entities that can be placed on a map, their size and color
// in the editor, and their properties. Sizes are in Quake units (32 units are about 1 meter in the game).

// The world: all static brushes of the level (walls, floors, ceilings) belong to it. Every map has exactly one.
@SolidClass = worldspawn : "World entity" []

// Where the player appears when the map starts. The box has the size of the Quake player: 32 x 32 units wide,
// 56 units tall, with the origin 24 units above its bottom.
@PointClass size(-16 -16 -24, 16 16 32) color(0 255 0) = info_player_start : "Player start"
[
    angle(integer) : "Direction the player looks, in degrees around the vertical axis" : 0
]

// A model standing in the level, drawn as it is (it does not move and cannot be picked up). The model is a glTF file
// in Assets (.glb). TrenchBroom shows it too; models are made in meters, so the editor scales them by 32 to map units.
@PointClass size(-8 -8 -8, 8 8 8) color(255 128 0) model({ "path": model, "scale": 32 }) = misc_model : "Model"
[
    model(string) : "Model file, relative to the Assets folder" : "Models/Weapons/Shotgun.glb"
    angle(integer) : "Direction the model faces, in degrees around the vertical axis" : 0
]

// A target to shoot at until the first enemy (0.3 only): it takes damage, is pushed by shots and comes back 3 seconds
// after it is destroyed. The box is that of the player.
@PointClass size(-16 -16 -24, 16 16 32) color(255 200 0) model({ "path": "Models/Enemies/Dummy.glb", "scale": 32 }) = target_dummy : "Target dummy"
[
    angle(integer) : "Direction the dummy faces, in degrees around the vertical axis" : 0
]
