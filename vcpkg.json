{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "abomination",
  "version": "0.1.0",
  "description": "A retro first-person shooter inspired by Quake (1996).",
  "builtin-baseline": "5f96cd15fd745122cf27e0524606d6c1efc5fd07",
  "dependencies": [
    "glm",
    "gtest",
    {
      "name": "imgui",
      "features": [
        "opengl3-binding",
        "sdl3-binding"
      ]
    },
    "cgltf",
    {
      "name": "freetype",
      "default-features": false
    },
    "miniaudio",
    "recastnavigation",
    "rmlui",
    "sdl3",
    {
      "name": "spdlog",
      "default-features": false
    },
    "stb"
  ]
}
